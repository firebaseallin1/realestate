# Copy this file to .env and fill it in. Git ignores .env, so secrets stay on this machine.

# Your MongoDB connection string. It must name the database, e.g. .../kaira_dev?retryWrites=true
# Use a separate database for development, not one with real data.
MONGODB_URI=

# Signs login tokens. At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

PORT=1001
NODE_ENV=development

# Production only: web addresses allowed to call the API, comma separated.
# In development any http://localhost port is allowed.
CORS_ORIGINS=

# Optional: reads scanned and handwritten bills with Claude. Leave empty to read bills on the device only.
# Create a key at https://platform.claude.com/settings/keys (each bill read is billed to that account).
ANTHROPIC_API_KEY=
